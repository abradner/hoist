# --- Universal ---
.DS_Store
Thumbs.db
*.log
tmp/
*.swp
*.swo

# Local agent config (per-machine permissions — never shared)
.claude/settings.local.json

# Session context handoffs (park-context skill) — local working state, and they
# can carry session detail that shouldn't land in a public repo's history
.claude/handoffs/

# Env files — commit templates (.env.template*), never real values
.env
.env.*
!.env.template
!.env.template.*

# IDE local state (uncomment if unwanted in this repo)
# .idea/
# .vscode/

# --- [KEEL:FILL — uncomment the block(s) for this repo's stack, delete the rest] ---

# Ruby/Rails
# When using this block, DELETE the universal `tmp/` and `*.log` lines above.
# Rails tracks .keep files inside otherwise-ignored directories, and git cannot
# honour a negation beneath a directory-form exclusion — `tmp/` makes
# `!/tmp/.keep` unreachable. The path-scoped forms below replace them.
# Note also that `rails new --skip-git` generates no .gitignore at all while
# still generating config/master.key, so these rules have to land in the same
# commit as the scaffold — not a later one.
# /.bundle
# /vendor/bundle
# /log/*
# !/log/.keep
# /tmp/*
# !/tmp/.keep
# /tmp/pids/*
# !/tmp/pids/
# !/tmp/pids/.keep
# /storage/*
# !/storage/.keep
# /tmp/storage/*
# !/tmp/storage/
# !/tmp/storage/.keep
# /public/assets
# /config/*.key
# /config/master.key
# /app/assets/builds/*
# !/app/assets/builds/.keep
# /node_modules

# Go
# /bin/
# *.test
# coverage.out

# Node/TypeScript (bun, npm, pnpm)
# node_modules/
# dist/
# coverage/
# *.tsbuildinfo
