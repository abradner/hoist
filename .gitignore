# --- Universal ---
.DS_Store
Thumbs.db
*.log
tmp/
*.swp
*.swo

# Local agent config (per-machine permissions — never shared)
.claude/settings.local.json

# Session context handoffs (park-context skill) — local working state, and they
# can carry session detail that shouldn't land in a public repo's history
.claude/handoffs/

# Env files — commit templates (.env.template*), never real values
.env
.env.*
!.env.template
!.env.template.*

# IDE local state (uncomment if unwanted in this repo)
# .idea/
# .vscode/

# --- Go ---
/bin/
/dist/
*.test
coverage.out

# hoist local state never belongs in the repo (XDG dirs are the real home;
# these guard against a misconfigured HOIST_STATE_DIR pointing inside the tree)
/.hoist/

# go build ./... drops the single main binary in the tree root
/hoist
